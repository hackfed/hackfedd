# /etc/systemd/system/hackfedd.service
[Unit]
Description=Hackfed host daemon
Wants=network-online.target
After=network-online.target
Before=asterisk.service

[Service]
Type=simple
User=root
Group=root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/root/.bun/bin
ExecStart=/root/.bun/bin/bunx --bun hackfed/hackfedd --config /etc/hackfed/config.yaml
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
