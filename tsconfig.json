{
  "$schema": "https://json.schemastore.org/tsconfig",
  "_version": "2.0.0",
  "extends": "@bksp/style-guide/typescript",
  "compilerOptions": {
    "lib": ["es2023"],
		"target": "es2023",
		"moduleDetection": "force",
		"module": "preserve",
		"resolveJsonModule": true,
		"allowJs": true,
		"verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "tools/**/*.ts"
  ]
}
